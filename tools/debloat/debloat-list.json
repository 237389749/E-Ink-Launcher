{
  "device": "BOOX Poke6 / Onyx Poke6 (SDM662, Android 11, build 51326)",
  "source": "ota/images/{system,product,system_ext,vendor}.img 内的 APK + aapt2 dump badging",
  "notes": [
    "size_mb 是镜像里 APK 的实际字节数（含内嵌 native lib），不是安装后占用。",
    "action=disable 用 pm disable-user --user 0（保留 APK，可 pm enable 回滚）。",
    "action=uninstall 用 pm uninstall --user 0（对系统 app 只是移除该用户，仍可 install-existing 回滚）。",
    "默认只跑 t1；t2/t3/t4 需要显式 -Tier。"
  ],
  "keep": [
    {"pkg": "com.onyx", "why": "内容浏览器/设置/OTA 入口，删了没有设置界面，也无法触发系统更新"},
    {"pkg": "com.onyx.kreader", "why": "NeoReader，打开 PDF/EPUB/笔记的默认阅读器；kcb 会拉起它"},
    {"pkg": "com.onyx.kime", "why": "Onyx 输入法；Legado 搜索/书源输入要用（与 com.onyx.latinime 二选一）"},
    {"pkg": "com.onyx.floatingbutton", "why": "NaviBall 悬浮球；若已用 E-Ink Launcher 手势可自行降级为 t2"},
    {"pkg": "com.onyx.android.onyxotaservice", "why": "OTA 安装服务；不再要 OTA 可关，但关了 kcb 的更新入口会报错"},
    {"pkg": "com.android.webview", "why": "WebView；Legado 书源/网页登录必需"},
    {"pkg": "com.android.systemui", "why": "状态栏/导航/音量面板"},
    {"pkg": "com.android.settings", "why": "系统设置"},
    {"pkg": "com.qti.service.colorservice", "why": "显示色彩服务，与 EPD 相关，勿动"},
    {"pkg": "com.qualcomm.qti.dynamicddsservice", "why": "动态显示切换，与 EPD 相关，勿动"},
    {"pkg": "com.android.permissioncontroller", "why": "权限对话框"},
    {"pkg": "com.android.packageinstaller", "why": "装 APK 的界面"}
  ],
  "packages": [
    {"pkg": "com.onyx.igetshop", "tier": "t1", "action": "disable", "size_mb": 155.8, "label": "IGetShop", "why": "Onyx 应用商店/书城，常驻推送与自更新来源"},
    {"pkg": "com.onyx.appmarket", "tier": "t1", "action": "disable", "size_mb": 20.1, "label": "App Store", "why": "应用市场，与 igetshop 功能重叠"},
    {"pkg": "com.onyx.android.ksync", "tier": "t1", "action": "disable", "size_mb": 79.5, "label": "ksync", "why": "云同步（书架/笔记/进度）后台服务；不用 Boox 云可关"},
    {"pkg": "com.onyx.mail", "tier": "t1", "action": "disable", "size_mb": 37.0, "label": "Calendar Memo", "why": "邮件/便签同步，阅读器用不到"},
    {"pkg": "com.onyx.aiassistant", "tier": "t1", "action": "disable", "size_mb": 31.6, "label": "AI Assistant", "why": "语音/AI 助手，麦克风常驻监听风险"},
    {"pkg": "com.onyx.easytransfer", "tier": "t1", "action": "disable", "size_mb": 64.8, "label": "BOOXDrop", "why": "局域网传输；用 adb push / Syncthing 可替代"},
    {"pkg": "com.onyx.android.production.test", "tier": "t1", "action": "disable", "size_mb": 41.2, "label": "工厂测试", "why": "产线测试 App，普通用户无用"},
    {"pkg": "com.onyx.gallery", "tier": "t2", "action": "disable", "size_mb": 46.5, "label": "Gallery", "why": "图片查看器"},
