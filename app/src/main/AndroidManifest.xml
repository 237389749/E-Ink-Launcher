<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--package="cn.modificator.launcher" android:sharedUserId="android.uid.system">-->

    <uses-permission android:name="android.permission.RESTART_PACKAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SHUTDOWN" />
    <uses-permission android:name="android.permission.REBOOT" />
    <uses-permission android:name="android.permission.DELETE_PACKAGES"/>
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="cn.modificator.launcher.Launcher"
            android:launchMode="singleInstance"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category
                    android:name="com.yotadevices.intent.category.EPD_HOME" />
            </intent-filter>
            <meta-data android:name="com.yotadevices.keep_on_epd_screen" android:value="true"/>
        </activity>

        <service
            android:name=".ftpservice.FTPService"
            android:enabled="true"
            android:exported="true" />

        <receiver
            android:name=".model.AdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN" android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/lock" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".ftpservice.FTPReceiver"
            android:exported="false">
        </receiver>
        
        <provider
            android:authorities="${applicationId}.fileProvider"
            android:grantUriPermissions="true"
            android:name="androidx.core.content.FileProvider">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/filepath"/>
        </provider>

        <activity android:name=".CrashDetailPage"
            android:process=":crash_page" android:exported="false">
            <meta-data android:name="com.yotadevices.keep_on_epd_screen" android:value="true"/>
        </activity>

        <service android:name=".model.HomeEntranceService">
        </service>

        <!-- 设置桥接：接收 Onyx 自定义 action，转发到原生设置 -->
        <activity
            android:name=".SettingsBridgeActivity"
            android:theme="@style/Theme.Transparent"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="">
            <!-- 设置主页 -->
            <intent-filter>
                <action android:name="com.onyx.action.SETTING"/>
                <action android:name="com.setting.action.CHILD_APP_MANAGEMENT"/>
                <action android:name="com.setting.action.CHILD_LIBRARY_MANAGEMENT"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <!-- 语言 / 日期 / 网络 / WiFi / 蓝牙 -->
            <intent-filter>
                <action android:name="onyx.settings.action.language"/>
                <action android:name="onyx.settings.action.datetime"/>
                <action android:name="onyx.settings.action.network"/>
                <action android:name="onyx.settings.action.wifi"/>
                <action android:name="onyx.settings.action.bluetooth"/>
                <action android:name="android.intent.action.WIFI_ENABLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <!-- 声音 / 通知 / 电源 / 安全 -->
            <intent-filter>
                <action android:name="onyx.settings.action.SoundSettings"/>
                <action android:name="onyx.settings.action.APP_NOTIFICATION_MANAGER"/>
                <action android:name="onyx.settings.action.powermanager"/>
                <action android:name="onyx.settings.action.SYSTEM_PASSWORD_SETTING"/>
                <action android:name="onyx.settings.action.password_manager"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <!-- 应用管理 / 反馈 / 辅助功能 -->
            <intent-filter>
                <action android:name="onyx.settings.action.app.management"/>
                <action android:name="onyx.settings.action.feedback"/>
                <action android:name="onyx.settings.action.SUBMIT_FEEDBACK"/>
                <action android:name="onyx.settings.action.accessibility"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <!-- 工作模式 / WLAN 共享 (SystemUI 磁贴) -->
            <intent-filter>
                <action android:name="com.android.systemui.CONFIGURE_WORK_PROFILE_ACTION"/>
                <action android:name="com.android.systemui.CONFIGURE_TABLET_WORK_PROFILE_ACTION"/>
                <action android:name="com.android.systemui.CONFIGURE_WLAN_NETWORK_SHARE_ACTION"/>
                <action android:name="com.android.systemui.CONFIGURE_TABLET_WLAN_NETWORK_SHARE_ACTION"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <!-- OTA / 固件 / 屏保 / 关机画面 / 刷新模式 -->
            <intent-filter>
                <action android:name="onyx.settings.action.firmware"/>
                <action android:name="onyx.settings.action.ACTIVE_PEN_FIRMWARE"/>
                <action android:name="onyx.settings.action.SHUTDOWN_IMAGE_SETTING"/>
                <action android:name="onyx.settings.action.DREAM_STYLE_SETTING"/>
                <action android:name="onyx.settings.action.OTHER_DREAM_SETTING_GUIDE"/>
                <action android:name="com.onyx.reader.settings.action.REFRESH_HELP"/>
                <action android:name="com.onyx.reader.settings.action.REFRESH_SETTINGS"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <!-- 其他 Onyx 独有功能 -->
            <intent-filter>
                <action android:name="onyx.settings.action.QUICK_LAUNCHER"/>
                <action android:name="onyx.settings.action.MAIL_SETTING"/>
                <action android:name="onyx.settings.action.CUSTOM_SIDE_KEY"/>
                <action android:name="onyx.settings.action.SCROLL_BUTTON_SETTING"/>
                <action android:name="onyx.settings.action.STATISTICS"/>
                <action android:name="onyx.settings.action.MY_ANNOTATION"/>
                <action android:name="onyx.settings.action.library"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
    </application>

</manifest>